#!/usr/bin/env python3
"""Fail on any qmllint warning that the app's baseline (scripts/qmllint-baseline.txt) does not list.

qmllint cannot see Quickshell's or the Omarchy shell's types, so the QML files carry hundreds of standing "unqualified
access" warnings; what matters is a new one, which is how a misspelt id, or a property that no longer exists, shows up before
the shell is restarted. An entry is the file, the warning's category and, for an unqualified access, the name itself, so
using a known name again adds nothing and a new name fails.

  qmllint            check the *.qml files at the app's root
  qmllint --update   rewrite the baseline

The app is DEVKIT_APP_ROOT, else the git root of the folder this is run in. The baseline is scripts/qmllint-baseline.txt there, or
the file DEVKIT_QML_BASELINE names (relative to the app).
Some warnings are bugs, never noise: a property that shadows one of Item's own (`data`, `state`, `children`), an id that shadows
a property, a property bound twice, an id used twice (it also stops qmllint's analysis early, hiding other warnings). They are not baselineable: they fail the check even when the baseline lists them, and
--update refuses to write while one is present. (A property named `data` once got through a blind --update.)
"""
import json
import os
import pathlib
import re
import subprocess
import sys


def app_root():
    if os.environ.get("DEVKIT_APP_ROOT"):
        return pathlib.Path(os.environ["DEVKIT_APP_ROOT"])
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    return pathlib.Path(top or os.getcwd())


root = app_root()
baseline_path = root / os.environ.get("DEVKIT_QML_BASELINE", "scripts/qmllint-baseline.txt")
files = sorted(p.name for p in root.glob("*.qml"))
NEVER_BASELINE = {"property-override", "id-shadows-member", "duplicate-property-binding", "syntax.duplicate-ids", "duplicate-ids"}


def find_qmllint():
    for candidate in ("qmllint", "qmllint6", "/usr/lib/qt6/bin/qmllint"):
        try:
            subprocess.run([candidate, "--version"], capture_output=True, check=True)
            return candidate
        except (OSError, subprocess.CalledProcessError):
            continue
    return None


def current_entries(qmllint):
    # qmllint exits non-zero when it has warnings; the report is still on stdout.
    out = subprocess.run([qmllint, "--json", "-", *files], cwd=root, capture_output=True, text=True).stdout
    report = json.loads(out)
    entries = set()
    for f in report["files"]:
        name = pathlib.Path(f["filename"]).name
        source = (root / name).read_text(encoding="utf-8")
        for w in f["warnings"]:
            # A warning qmllint gives no id (an import it cannot resolve, say) is listed under "other", so it shows as new and is read, not a crash.
            wid = w.get("id") or "other"
            if wid == "unqualified":
                detail = source[w["charOffset"]:w["charOffset"] + w["length"]]
            else:
                detail = w["message"]
            entries.add("\t".join([name, wid, re.sub(r"\s+", " ", detail)]))
    return sorted(entries)


qmllint = find_qmllint()
if not qmllint:
    print("qmllint: SKIPPED, qmllint not found (install qt6-declarative to run it)")
    sys.exit(0)

current = current_entries(qmllint)
bugs = [e for e in current if e.split("\t")[1] in NEVER_BASELINE]
if bugs:
    print("qmllint: these are bugs, not noise, and cannot be baselined (file, category, message):", file=sys.stderr)
    for e in bugs:
        print("  " + "  |  ".join(e.split("\t")), file=sys.stderr)
    print("\nRename the property or id (a name Item already has, such as data, state, children or parent, hides its own).", file=sys.stderr)
    sys.exit(1)
if "--update" in sys.argv:
    baseline_path.write_text("\n".join(current) + "\n", encoding="utf-8")
    print(f"qmllint: baseline rewritten with {len(current)} entries")
    sys.exit(0)

if not baseline_path.exists():
    print(f"qmllint: no baseline at {baseline_path}; create it with: qmllint --update", file=sys.stderr)
    sys.exit(1)
baseline = set(baseline_path.read_text(encoding="utf-8").split("\n")) - {""}
added = [e for e in current if e not in baseline]
gone = [e for e in baseline if e not in set(current)]
if added:
    print("qmllint: new warnings (file, category, name or message):", file=sys.stderr)
    for e in added:
        print("  " + "  |  ".join(e.split("\t")), file=sys.stderr)
    print("\nA new unqualified name is usually a misspelt or removed id or property.", file=sys.stderr)
    print("If it is a real name from the shell (Color, Style, ...), accept it with:", file=sys.stderr)
    print("  qmllint --update", file=sys.stderr)
    sys.exit(1)
tail = f"; {len(gone)} baseline entries no longer occur (qmllint --update drops them)" if gone else ""
print(f"qmllint: ok, {len(current)} known warnings, none new{tail}")
